{%- comment -%}
  Simple AEONAE content blocks for the main product section. One snippet keeps
  main-product.liquid lean; each block type renders its own root element with
  block.shopify_attributes so the theme editor can select it.

  Block types handled:
  - aeo_benefits      check list (up to five lines)
  - aeo_specs         spec chips from a comma-separated list
  - aeo_guarantee     returns promise card with a round seal
  - aeo_reassurance   check list + "email us" line from Theme settings > AEONAE brand > Customer care
  - aeo_trust_inline  divided inline trust row from a comma-separated list
  - aeo_allergen      allergen notice with a diamond marker

  Accepts:
  - block {Block} - the block

  Usage:
  {% render 'aeonae-product-detail', block: block %}
{%- endcomment -%}

{%- case block.type -%}
  {%- when 'aeo_benefits' -%}
    {%- capture benefit_items -%}
      {%- for i in (1..5) -%}
        {%- assign benefit_key = 'benefit_' | append: i -%}
        {%- assign benefit = block.settings[benefit_key] -%}
        {%- if benefit != blank -%}
          <li><span>{{ benefit }}</span></li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if benefit_items != blank -%}
      <ul class="aeo-check-list aeo-pdp-benefits" {{ block.shopify_attributes }}>
        {{- benefit_items -}}
      </ul>
    {%- endif -%}

  {%- when 'aeo_specs' -%}
    {%- assign chips = block.settings.chips | split: ',' -%}
    {%- if chips.size > 0 -%}
      <ul
        class="aeo-chips aeo-pdp-specs"
        {% if block.settings.list_label != blank %}
          aria-label="{{ block.settings.list_label | escape }}"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {%- for chip in chips -%}
          {%- assign chip_text = chip | strip -%}
          {%- if chip_text != blank -%}
            <li>{{ chip_text | escape }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

  {%- when 'aeo_guarantee' -%}
    <div class="aeo-guarantee" {{ block.shopify_attributes }}>
      {%- if block.settings.seal != blank -%}
        <span class="aeo-guarantee__seal" aria-hidden="true">{{ block.settings.seal | escape }}</span>
      {%- endif -%}
      <div class="aeo-guarantee__copy">
        {%- if block.settings.title != blank -%}
          <p class="aeo-guarantee__title">{{ block.settings.title | escape }}</p>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <p class="aeo-guarantee__text">{{ block.settings.text }}</p>
        {%- endif -%}
      </div>
    </div>

  {%- when 'aeo_reassurance' -%}
    {%- liquid
      assign support_email = settings.aeo_support_email | strip
      assign support_note = settings.aeo_support_note | strip
      assign show_support = false
      if block.settings.show_support and support_email != blank
        assign show_support = true
      endif
    -%}
    {%- capture reassurance_items -%}
      {%- for i in (1..3) -%}
        {%- assign line_key = 'line_' | append: i -%}
        {%- assign line = block.settings[line_key] -%}
        {%- if line != blank -%}
          <li><span>{{ line }}</span></li>
        {%- endif -%}
      {%- endfor -%}
      {%- if show_support -%}
        <li>
          <span>
            {%- if block.settings.support_lead != blank -%}
              {{ block.settings.support_lead | escape }}{{ ' ' }}
            {%- endif -%}
            <a class="aeo-reassure__link" href="mailto:{{ support_email | escape }}">
              {{- block.settings.support_link | default: 'Email us' | escape -}}
            </a>
            {%- if support_note != blank -%}
              {%- assign note_first = support_note | slice: 0 | downcase -%}
              {%- assign note_rest = support_note | slice: 1, 500 -%}
              {{ ' and ' }}{{ note_first | append: note_rest | escape }}
            {%- endif -%}
          </span>
        </li>
      {%- endif -%}
    {%- endcapture -%}
    {%- if reassurance_items != blank -%}
      <ul class="aeo-check-list aeo-reassure" {{ block.shopify_attributes }}>
        {{- reassurance_items -}}
      </ul>
    {%- endif -%}

  {%- when 'aeo_trust_inline' -%}
    {%- assign trust_items = block.settings.items | split: ',' -%}
    {%- if trust_items.size > 0 -%}
      <ul class="aeo-divided aeo-pdp-trust" {{ block.shopify_attributes }}>
        {%- for item in trust_items -%}
          {%- assign item_text = item | strip -%}
          {%- if item_text != blank -%}
            <li>{{ item_text | escape }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

  {%- when 'aeo_allergen' -%}
    {%- if block.settings.text != blank -%}
      <div class="aeo-allergen" role="note" {{ block.shopify_attributes }}>
        <span class="aeo-allergen__icon" aria-hidden="true">&#9670;</span>
        <div class="aeo-allergen__text">{{ block.settings.text }}</div>
      </div>
    {%- endif -%}
{%- endcase -%}
