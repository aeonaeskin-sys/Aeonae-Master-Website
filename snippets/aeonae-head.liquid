{%- comment -%}
  AEONAE design tokens, brand fonts and base stylesheet.
  Rendered from layout/theme.liquid directly after base.css so the
  overrides here win over Dawn defaults without editing base.css.
{%- endcomment -%}

{%- assign aeo_copper_text = settings.aeo_copper | color_darken: 12 -%}

{%- if settings.aeo_brand_fonts -%}
  {% comment %}theme-check-disable AssetPreload{% endcomment %}
  <link rel="preload" as="font" href="{{ 'aeonae-fraunces.woff2' | asset_url }}" type="font/woff2" crossorigin>
  <link rel="preload" as="font" href="{{ 'aeonae-hanken-grotesk.woff2' | asset_url }}" type="font/woff2" crossorigin>
  {% comment %}theme-check-enable AssetPreload{% endcomment %}
{%- endif -%}

{% style %}
  {%- if settings.aeo_brand_fonts -%}
    @font-face {
      font-family: 'Fraunces';
      font-style: normal;
      font-weight: 300 500;
      font-display: swap;
      src: url('{{ 'aeonae-fraunces.woff2' | asset_url }}') format('woff2');
    }
    @font-face {
      font-family: 'Fraunces';
      font-style: italic;
      font-weight: 300 400;
      font-display: swap;
      src: url('{{ 'aeonae-fraunces-italic.woff2' | asset_url }}') format('woff2');
    }
    @font-face {
      font-family: 'Hanken Grotesk';
      font-style: normal;
      font-weight: 300 700;
      font-display: swap;
      src: url('{{ 'aeonae-hanken-grotesk.woff2' | asset_url }}') format('woff2');
    }
  {%- endif -%}

  :root {
    {%- if settings.aeo_brand_fonts %}
      --font-heading-family: 'Fraunces', Georgia, 'Times New Roman', serif;
      --font-heading-style: normal;
      --font-heading-weight: 400;
      --font-body-family: 'Hanken Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif;
      --font-body-style: normal;
      --font-body-weight: 400;
      --font-body-weight-bold: 600;
    {%- endif %}
    --aeo-accent: {{ settings.aeo_accent }};
    --aeo-accent-rgb: {{ settings.aeo_accent.red }}, {{ settings.aeo_accent.green }}, {{ settings.aeo_accent.blue }};
    --aeo-copper: {{ settings.aeo_copper }};
    --aeo-copper-text: {{ aeo_copper_text }};
    --aeo-line: {{ settings.aeo_line }};
    --aeo-halo-rgb: {{ settings.aeo_halo.red }}, {{ settings.aeo_halo.green }}, {{ settings.aeo_halo.blue }};
  }
{% endstyle %}

{%- comment -%}
  Safety net: if the store has lost its saved color schemes (for example after a failed settings
  import), Dawn's layout outputs no color variables and every page renders unstyled: white page,
  black text, invisible buttons, input borders and drawer backgrounds. This re-creates the AEONAE
  schemes from config/settings_data.json so the storefront never falls back to that state.
{%- endcomment -%}
{%- comment -%}
  Count schemes that actually carry colors. A store can list schemes whose values are empty (seen when
  its settings_schema.json is out of sync): Dawn then writes blank variables such as
  "--color-background: ,,;", which are still "defined" and override any var() fallback.
{%- endcomment -%}
{%- assign aeo_scheme_count = 0 -%}
{%- for scheme in settings.color_schemes -%}
  {%- if scheme.settings.background != blank and scheme.settings.text != blank and scheme.settings.button != blank -%}
    {%- assign aeo_scheme_count = aeo_scheme_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- if aeo_scheme_count == 0 -%}
  {% style %}
    :root,
    .color-scheme-1 {
      --color-background: 244,237,225;
      --gradient-background: #F4EDE1;
      --color-foreground: 43,38,32;
      --color-background-contrast: 210,181,132;
      --color-shadow: 42,36,29;
      --color-button: 79,94,56;
      --color-button-text: 255,255,255;
      --color-secondary-button: 244,237,225;
      --color-secondary-button-text: 42,36,29;
      --color-link: 42,36,29;
      --color-badge-foreground: 43,38,32;
      --color-badge-background: 244,237,225;
      --color-badge-border: 43,38,32;
      --payment-terms-background-color: rgb(244,237,225);
    }
    .color-scheme-2 {
      --color-background: 252,248,241;
      --gradient-background: #FCF8F1;
      --color-foreground: 43,38,32;
      --color-background-contrast: 230,195,136;
      --color-shadow: 42,36,29;
      --color-button: 79,94,56;
      --color-button-text: 255,255,255;
      --color-secondary-button: 252,248,241;
      --color-secondary-button-text: 42,36,29;
      --color-link: 42,36,29;
      --color-badge-foreground: 43,38,32;
      --color-badge-background: 252,248,241;
      --color-badge-border: 43,38,32;
      --payment-terms-background-color: rgb(252,248,241);
    }
    .color-scheme-3 {
      --color-background: 239,231,216;
      --gradient-background: #EFE7D8;
      --color-foreground: 43,38,32;
      --color-background-contrast: 202,175,126;
      --color-shadow: 42,36,29;
      --color-button: 79,94,56;
      --color-button-text: 255,255,255;
      --color-secondary-button: 239,231,216;
      --color-secondary-button-text: 42,36,29;
      --color-link: 42,36,29;
      --color-badge-foreground: 43,38,32;
      --color-badge-background: 239,231,216;
      --color-badge-border: 43,38,32;
      --payment-terms-background-color: rgb(239,231,216);
    }
    .color-scheme-4 {
      --color-background: 42,36,29;
      --gradient-background: #2A241D;
      --color-foreground: 236,228,214;
      --color-background-contrast: 180,164,146;
      --color-shadow: 0,0,0;
      --color-button: 79,94,56;
      --color-button-text: 255,255,255;
      --color-secondary-button: 42,36,29;
      --color-secondary-button-text: 255,255,255;
      --color-link: 255,255,255;
      --color-badge-foreground: 236,228,214;
      --color-badge-background: 42,36,29;
      --color-badge-border: 236,228,214;
      --payment-terms-background-color: rgb(42,36,29);
    }
    .color-scheme-5 {
      --color-background: 231,221,204;
      --gradient-background: #E7DDCC;
      --color-foreground: 43,38,32;
      --color-background-contrast: 190,163,117;
      --color-shadow: 42,36,29;
      --color-button: 79,94,56;
      --color-button-text: 255,255,255;
      --color-secondary-button: 231,221,204;
      --color-secondary-button-text: 42,36,29;
      --color-link: 42,36,29;
      --color-badge-foreground: 43,38,32;
      --color-badge-background: 231,221,204;
      --color-badge-border: 43,38,32;
      --payment-terms-background-color: rgb(231,221,204);
    }

    body, .color-scheme-1, .color-scheme-2, .color-scheme-3, .color-scheme-4, .color-scheme-5 {
      color: rgba(var(--color-foreground), 0.75);
      background-color: rgb(var(--color-background));
    }
  {% endstyle %}
{%- endif -%}

{{ 'aeonae.css' | asset_url | stylesheet_tag }}

<script>
  (function () {
    var root = document.documentElement;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;
    {%- if settings.animations_reveal_on_scroll %}
      root.classList.add('aeo-motion');
    {%- endif %}
    {%- if settings.aeo_ambient_motion %}
      root.classList.add('aeo-ambient');
    {%- endif %}
  })();
</script>
