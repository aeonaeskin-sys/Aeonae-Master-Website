{%- comment -%}
  The AEONAE serum bottle illustration from the reference design.
  It stands in for product photography until real photos are uploaded.
  Gradient ids are suffixed with uid so several bottles can share a page.

  Accepts:
  - uid {String} - unique suffix (e.g. section.id). Required when more than one bottle is on the page
  - class {String} - extra classes on the wrapper
  - decorative {Boolean} - hide from assistive tech when the product name is already announced nearby

  Usage:
  {% render 'aeonae-bottle', uid: section.id, class: 'aeo-float' %}
{%- endcomment -%}

{%- assign u = uid | default: 'b' | handleize -%}
<div class="aeo-bottle{% if class != blank %} {{ class }}{% endif %}">
  <svg
    viewBox="0 0 240 470"
    xmlns="http://www.w3.org/2000/svg"
    {% if decorative %}
      aria-hidden="true" focusable="false"
    {% else %}
      role="img" aria-label="Illustration of the AEONAE copper peptide serum bottle"
    {% endif %}
  >
    <defs>
      <linearGradient id="aeo-gv-{{ u }}" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#F7FAEE"/><stop offset=".16" stop-color="#E6EFD6"/><stop offset=".5" stop-color="#C2D3A2"/><stop offset=".82" stop-color="#97AC74"/><stop offset="1" stop-color="#C6D6A8"/>
      </linearGradient>
      <linearGradient id="aeo-gcap-{{ u }}" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#2C3720"/><stop offset=".5" stop-color="#4F5E38"/><stop offset="1" stop-color="#232C18"/>
      </linearGradient>
      <linearGradient id="aeo-gl-{{ u }}" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity=".85"/><stop offset="1" stop-color="#fff" stop-opacity="0"/>
      </linearGradient>
      <filter id="aeo-sh-{{ u }}" x="-30%" y="-10%" width="160%" height="130%">
        <feDropShadow dx="0" dy="16" stdDeviation="18" flood-color="#2C3720" flood-opacity="0.16"/>
      </filter>
    </defs>
    <g filter="url(#aeo-sh-{{ u }})">
      <rect x="86" y="8" width="68" height="60" rx="13" fill="url(#aeo-gcap-{{ u }})"/>
      <rect x="93" y="14" width="8" height="48" rx="4" fill="#fff" opacity=".16"/>
      <g opacity=".45" stroke="#04101f" stroke-width="1">
        <line x1="108" y1="58" x2="108" y2="66"/><line x1="118" y1="58" x2="118" y2="66"/><line x1="128" y1="58" x2="128" y2="66"/><line x1="138" y1="58" x2="138" y2="66"/>
      </g>
      <rect x="95" y="66" width="50" height="16" rx="3" fill="#3A4526"/>
      <path d="M56 116 C56 96 74 84 120 84 C166 84 184 96 184 116 L184 430 C184 450 168 462 148 462 L92 462 C72 462 56 450 56 430 Z" fill="url(#aeo-gv-{{ u }})"/>
      <path d="M56 116 C56 96 74 84 120 84 C166 84 184 96 184 116 L184 430 C184 450 168 462 148 462 L92 462 C72 462 56 450 56 430 Z" fill="none" stroke="#ffffff" stroke-width="1.2" opacity=".55"/>
      <rect x="67" y="104" width="12" height="300" rx="6" fill="url(#aeo-gl-{{ u }})"/>
      <rect x="170" y="120" width="5" height="300" rx="2.5" fill="#fff" opacity=".4"/>
      <rect x="74" y="214" width="92" height="150" rx="7" fill="#FFFFFF"/>
      <rect x="74" y="214" width="92" height="150" rx="7" fill="none" stroke="#E2E6D2" stroke-width="1"/>
      <text x="120" y="244" text-anchor="middle" font-family="Fraunces,Georgia,serif" font-size="15" letter-spacing="3" fill="#2C3720">AEONAE</text>
      <line x1="103" y1="255" x2="137" y2="255" stroke="#4F5E38" stroke-width="1"/>
      <text x="120" y="286" text-anchor="middle" font-family="Hanken Grotesk,system-ui,sans-serif" font-size="12" font-weight="700" fill="#4F5E38">1% GHK-Cu</text>
      <text x="120" y="304" text-anchor="middle" font-family="Hanken Grotesk,system-ui,sans-serif" font-size="7" letter-spacing="1.6" fill="#6B6F52">COPPER PEPTIDE SERUM</text>
      <text x="120" y="344" text-anchor="middle" font-family="Hanken Grotesk,system-ui,sans-serif" font-size="6.5" letter-spacing="1.2" fill="#6B6F52">30 ML   1.0 FL OZ</text>
    </g>
  </svg>
</div>
