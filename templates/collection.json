        },
        "item-2": {
          "type": "item",
          "settings": {
            "icon": "▣",
            "heading": "Made in the USA",
            "text": "Formulated and filled domestically."
          }
        },
        "item-3": {
          "type": "item",
          "settings": {
            "icon": "⚑",
            "heading": "Free shipping",
            "text": "On every US order, no minimum."
          }
        },
        "item-4": {
          "type": "item",
          "settings": {
            "icon": "✓",
            "heading": "14 day returns",
            "text": "On unopened bottles, no hassle."
          }
        }
      },
      "block_order": [
        "item-1",
        "item-2",
        "item-3",
        "item-4"
      ],
      "settings": {
        "color_scheme": "scheme-2",
        "show_borders": true,
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
