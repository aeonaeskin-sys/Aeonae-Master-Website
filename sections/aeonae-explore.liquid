{%- comment -%}
  AEONAE explore hub (artifact #explore .xgrid / .xcard).
  Each card is a single link (heading inside) that lifts on hover.
  A card without a link renders as a plain card.
{%- endcomment -%}

{{ 'aeonae-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign motion = settings.animations_reveal_on_scroll
  assign anim_order = 0
  assign card_count = 0
  for block in section.blocks
    if block.type == 'card'
      assign card_count = card_count | plus: 1
    endif
  endfor
-%}

<div
  class="aeo-explore aeo-section color-{{ section.settings.color_scheme }} gradient"
  style="--aeo-pt: {{ section.settings.padding_top }}; --aeo-pb: {{ section.settings.padding_bottom }};"
>
  <div class="aeo-wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="aeo-intro aeo-explore__intro">
        {%- if section.settings.eyebrow != blank -%}
          {%- assign anim_order = anim_order | plus: 1 -%}
          <p
            class="aeo-eyebrow aeo-explore__eyebrow{% if motion %} aeo-reveal scroll-trigger animate--slide-in{% endif %}"
            {% if motion %}
              data-cascade
              style="--animation-order: {{ anim_order }};"
            {% endif %}
          >
            {{- section.settings.eyebrow | escape -}}
          </p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          {%- assign anim_order = anim_order | plus: 1 -%}
          <h2
            class="aeo-h2 aeo-explore__heading{% if motion %} aeo-reveal scroll-trigger animate--slide-in{% endif %}"
            {% if motion %}
              data-cascade
              style="--animation-order: {{ anim_order }};"
            {% endif %}
          >
            {{- section.settings.heading -}}
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          {%- assign anim_order = anim_order | plus: 1 -%}
          <div
            class="aeo-soft aeo-rte aeo-explore__text{% if motion %} aeo-reveal scroll-trigger animate--slide-in{% endif %}"
            {% if motion %}
              data-cascade
              style="--animation-order: {{ anim_order }};"
            {% endif %}
          >
            {{- section.settings.text -}}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if card_count > 0 -%}
      <ul class="aeo-explore__grid" role="list" style="--aeo-cols: {{ card_count | at_most: 3 }};">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            {%- assign anim_order = anim_order | plus: 1 -%}
            {%- liquid
              assign card_id = 'AeoExplore-' | append: section.id | append: '-' | append: block.id
              assign has_link = false
              if block.settings.link != blank
                assign has_link = true
              endif
            -%}
            <li
              class="aeo-explore__item{% if motion %} aeo-reveal scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if motion %}
                data-cascade
                style="--animation-order: {{ anim_order }};"
              {% endif %}
            >
              {%- if has_link -%}
                <a
                  class="aeo-xcard aeo-card aeo-card--lift color-{{ section.settings.card_color_scheme }}"
                  href="{{ block.settings.link }}"
                  {% if block.settings.title != blank %}
                    aria-labelledby="{{ card_id }}-title{% if block.settings.link_label != blank %} {{ card_id }}-go{% endif %}"
                  {% endif %}
                  {% if block.settings.text != blank %}
                    aria-describedby="{{ card_id }}-text"
                  {% endif %}
                >
              {%- else -%}
                <div class="aeo-xcard aeo-card color-{{ section.settings.card_color_scheme }}">
              {%- endif -%}

              {%- if block.settings.category != blank -%}
                <p class="aeo-xcard__cat">{{ block.settings.category | escape }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="aeo-xcard__title" id="{{ card_id }}-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="aeo-xcard__text" id="{{ card_id }}-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
              {%- if has_link and block.settings.link_label != blank -%}
                <span class="aeo-xcard__go" id="{{ card_id }}-go">{{ block.settings.link_label | escape }}</span>
              {%- endif -%}

              {%- if has_link -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Explore cards",
  "tag": "section",
  "class": "section aeo-explore-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Introduction"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Go deeper"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Everything, in the open."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Three short reads: the science behind the serum, what to expect from it, and why we built AEONAE.</p>"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 124
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 124
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "default": "The Formula"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The Science"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Copper peptides, the actives, and the full formula printed in the open."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Explore the Science"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "The whole card links here. Leave empty for a card without a link."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Explore cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "category": "The Formula",
            "title": "The Science",
            "text": "Copper peptides, the actives, and the full formula printed in the open.",
            "link_label": "Explore the Science"
          }
        },
        {
          "type": "card",
          "settings": {
            "category": "The experience",
            "title": "Results and Ritual",
            "text": "What to expect over time, the daily ritual, and real customer photos.",
            "link_label": "See Results and Ritual"
          }
        },
        {
          "type": "card",
          "settings": {
            "category": "The brand",
            "title": "Our Story",
            "text": "Why we built AEONAE, and the standard we refuse to lower.",
            "link_label": "Read Our Story"
          }
        }
      ]
    }
  ]
}
{% endschema %}
