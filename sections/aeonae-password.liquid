{%- comment -%}
  AEONAE password page ("opening soon"): what visitors see while the store is password protected.
  Bottle and halo from the reference design, the brand promise, and a Shopify customer signup
  (tagged "newsletter" and "prelaunch") so early visitors are not lost. The store password
  link stays in the header (main-password-header).
{%- endcomment -%}

{{ 'aeonae-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'aeonae-password.css' | asset_url | stylesheet_tag }}

{%- assign form_id = 'AeoPrelaunch-' | append: section.id -%}

<section class="aeo-pw color-{{ section.settings.color_scheme }} gradient" aria-labelledby="AeoPwHeading-{{ section.id }}">
  <div class="aeo-wrap aeo-pw__grid">
    <div class="aeo-pw__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="aeo-eyebrow aeo-pw__in" style="--aeo-d: 0;">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="aeo-h1 aeo-pw__heading aeo-pw__in" id="AeoPwHeading-{{ section.id }}" style="--aeo-d: 1;">
        {{- section.settings.heading | default: shop.name -}}
      </h1>
      {%- if section.settings.text != blank -%}
        <div class="aeo-pw__text aeo-rte aeo-pw__in" style="--aeo-d: 2;">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="aeo-pw__signup aeo-pw__in" style="--aeo-d: 3;">
        {%- form 'customer', id: form_id, class: 'aeo-news__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
          {%- if form.posted_successfully? -%}
            <p class="aeo-news__msg aeo-news__msg--success" tabindex="-1" autofocus>
              {{- section.settings.success_text | escape -}}
            </p>
          {%- else -%}
            <div class="aeo-news__field">
              <label class="aeo-visually-hidden" for="AeoPrelaunchEmail-{{ section.id }}">
                {{- 'newsletter.label' | t -}}
              </label>
              <input
                id="AeoPrelaunchEmail-{{ section.id }}"
                class="aeo-news__input"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                placeholder="{{ section.settings.placeholder | escape }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                required
                aria-required="true"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="AeoPrelaunchError-{{ section.id }}"
                {% endif %}
              >
              <button type="submit" class="button aeo-news__button" name="commit">
                {{- section.settings.button_label | default: 'Notify me' | escape -}}
              </button>
            </div>
            {%- if form.errors -%}
              <div class="aeo-news__msg aeo-news__msg--error" id="AeoPrelaunchError-{{ section.id }}">
                {%- if form.errors contains 'email' -%}
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                {%- else -%}
                  {{ form.errors | default_errors }}
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
        {%- if section.settings.fine_print != blank -%}
          <p class="aeo-pw__fine">{{ section.settings.fine_print | escape }}</p>
        {%- endif -%}
      </div>

      {%- assign points = section.settings.points | split: ',' -%}
      {%- if section.settings.points != blank -%}
        <ul class="aeo-pw__points aeo-pw__in" role="list" style="--aeo-d: 4;">
          {%- for point in points -%}
            {%- assign p = point | strip -%}
            {%- if p != blank -%}
              <li>{{ p | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="aeo-pw__stage" aria-hidden="true">
      <div class="aeo-halo"></div>
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: class: 'aeo-pw__image aeo-float', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 40vw, 80vw', alt: ''
        }}
      {%- else -%}
        {%- render 'aeonae-bottle', uid: section.id, class: 'aeo-float aeo-bottle--reflect', decorative: true -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AEONAE opening soon",
  "tag": "div",
  "class": "aeo-pw-section",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "1% GHK-Cu Copper Peptide Serum"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A serum with nothing to hide."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>The First Edition is almost here. Leave your email and we will write once, the moment it opens.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "name@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thank you. We will write when the First Edition opens."
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "One email when we open. No noise, unsubscribe any time."
    },
    {
      "type": "text",
      "id": "points",
      "label": "Highlights",
      "info": "Separate with commas. Only list what is true for your store.",
      "default": "Every ingredient disclosed, Free US shipping, Made in the USA"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional product photo or transparent cut-out. Without one, the bottle illustration shows."
    }
  ]
}
{% endschema %}
