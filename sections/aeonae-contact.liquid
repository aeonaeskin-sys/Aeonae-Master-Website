{%- comment -%}
  AEONAE contact page. Uses Shopify's native contact form ({% form 'contact' %}), so messages
  arrive in the store's customer email exactly as before; nothing here is a front-end-only form.

  - Left column: heading, introduction, what the form is for, support email, privacy note.
  - Right column: the form with visible, labelled fields (labels above inputs, not inside them).
  - assets/aeonae-contact.js adds inline validation messages and a one-click "Sending…" state
    that prevents duplicate submissions. Without JavaScript the browser's own validation applies.
{%- endcomment -%}

{{ 'aeonae-contact.css' | asset_url | stylesheet_tag }}
<script src="{{ 'aeonae-contact.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading = section.settings.heading | default: page.title | default: 'Contact'
  assign support_email = settings.aeo_support_email | strip
  assign motion = settings.animations_reveal_on_scroll
  assign form_id = 'AeoContactForm-' | append: section.id
-%}

<div
  class="aeo-contact aeo-section color-{{ section.settings.color_scheme }} gradient"
  style="--aeo-pt: {{ section.settings.padding_top }}; --aeo-pb: {{ section.settings.padding_bottom }};"
>
  <div class="aeo-wrap aeo-contact__grid">
    <div class="aeo-contact__intro{% if motion %} aeo-reveal scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="aeo-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="aeo-h1 aeo-contact__heading">{{ heading | escape }}</h1>

      {%- if section.settings.text != blank -%}
        <div class="aeo-rte aeo-soft aeo-contact__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.show_page_content and page.content != blank -%}
        <div class="rte aeo-contact__page-content">{{ page.content }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="aeo-contact__topics">
          {%- if section.settings.topics_heading != blank -%}
            <h2 class="aeo-contact__subheading">{{ section.settings.topics_heading | escape }}</h2>
          {%- endif -%}
          <ul class="aeo-check-list" role="list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{{ block.settings.topic | escape }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if support_email != blank -%}
        <a class="aeo-contact__email" href="mailto:{{ support_email | escape }}">
          <span class="aeo-contact__email-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>
            </svg>
          </span>
          <span>
            <span class="aeo-contact__email-label">{{ section.settings.email_label | escape }}</span>
            <span class="aeo-contact__email-address">{{ support_email | escape }}</span>
          </span>
        </a>
      {%- endif -%}

      {%- if section.settings.response_note != blank -%}
        <p class="aeo-note aeo-contact__response">{{ section.settings.response_note | escape }}</p>
      {%- endif -%}
    </div>

    <div class="aeo-contact__card color-{{ section.settings.card_color_scheme }}{% if motion %} aeo-reveal scroll-trigger animate--slide-in{% endif %}">
      {%- form 'contact', id: form_id, class: 'aeo-contact__form', novalidate: 'novalidate', data-aeo-contact: '' -%}
        {%- if form.posted_successfully? -%}
          <div class="aeo-contact__status aeo-contact__status--success" role="status" tabindex="-1" data-aeo-contact-focus>
            <p class="aeo-contact__status-title">{{ section.settings.success_heading | escape }}</p>
            {%- if section.settings.success_text != blank -%}
              <p>{{ section.settings.success_text | escape }}</p>
            {%- endif -%}
          </div>
        {%- elsif form.errors -%}
          <div class="aeo-contact__status aeo-contact__status--error" role="alert" tabindex="-1" data-aeo-contact-focus>
            <p class="aeo-contact__status-title">{{ 'templates.contact.form.error_heading' | t }}</p>
            <ul role="list">
              {%- for field in form.errors -%}
                <li>
                  <a href="#{{ form_id }}-{{ field }}">
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                    {%- endif -%}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <p class="aeo-contact__required-note">
          <span aria-hidden="true">*</span> {{ section.settings.required_note | escape }}
        </p>

        <div class="aeo-contact__row">
          <div class="aeo-field">
            <label class="aeo-field__label" for="{{ form_id }}-name">{{ 'templates.contact.form.name' | t }}</label>
            <input
              class="aeo-field__input"
              type="text"
              id="{{ form_id }}-name"
              name="contact[{{ 'templates.contact.form.name' | t }}]"
              autocomplete="name"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </div>

          <div class="aeo-field">
            <label class="aeo-field__label" for="{{ form_id }}-email">
              {{- 'templates.contact.form.email' | t -}}
              <span class="aeo-field__req" aria-hidden="true">*</span>
            </label>
            <input
              class="aeo-field__input"
              type="email"
              id="{{ form_id }}-email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              required
              aria-required="true"
              aria-describedby="{{ form_id }}-email-error"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
              {% endif %}
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            >
            <p class="aeo-field__error" id="{{ form_id }}-email-error" data-aeo-error="{{ section.settings.email_error | escape }}">
              {%- if form.errors contains 'email' -%}
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              {%- endif -%}
            </p>
          </div>
        </div>

        {%- if section.settings.show_phone -%}
          <div class="aeo-field">
            <label class="aeo-field__label" for="{{ form_id }}-phone">
              {{- 'templates.contact.form.phone' | t }}
              <span class="aeo-field__optional">({{ section.settings.optional_label | escape }})</span>
            </label>
            <input
              class="aeo-field__input"
              type="tel"
              id="{{ form_id }}-phone"
              name="contact[{{ 'templates.contact.form.phone' | t }}]"
              autocomplete="tel"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            >
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 and section.settings.show_topic_select -%}
          <div class="aeo-field">
            <label class="aeo-field__label" for="{{ form_id }}-topic">{{ section.settings.topic_label | escape }}</label>
            <div class="aeo-field__select-wrap">
              <select class="aeo-field__input aeo-field__select" id="{{ form_id }}-topic" name="contact[{{ section.settings.topic_label | escape }}]">
                {%- for block in section.blocks -%}
                  <option value="{{ block.settings.topic | escape }}">{{ block.settings.topic | escape }}</option>
                {%- endfor -%}
              </select>
            </div>
          </div>
        {%- endif -%}

        <div class="aeo-field">
          <label class="aeo-field__label" for="{{ form_id }}-body">
            {{- section.settings.message_label | default: 'Message' | escape -}}
            <span class="aeo-field__req" aria-hidden="true">*</span>
          </label>
          <textarea
            class="aeo-field__input aeo-field__textarea"
            id="{{ form_id }}-body"
            name="contact[{{ 'templates.contact.form.comment' | t }}]"
            rows="6"
            required
            aria-required="true"
            aria-describedby="{{ form_id }}-body-error"
          >{{ form.body }}</textarea>
          <p class="aeo-field__error" id="{{ form_id }}-body-error" data-aeo-error="{{ section.settings.message_error | escape }}"></p>
        </div>

        <div class="aeo-contact__actions">
          <button type="submit" class="button aeo-contact__submit" data-aeo-contact-submit data-sending-label="{{ section.settings.sending_label | escape }}">
            <span data-aeo-contact-label>{{ section.settings.button_label | default: 'Send' | escape }}</span>
          </button>
          {%- if shop.privacy_policy -%}
            <p class="aeo-contact__privacy">
              {{ section.settings.privacy_text | escape }}
              <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a>.
            </p>
          {%- endif -%}
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact page",
  "tag": "section",
  "class": "section",
  "limit": 1,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color_scheme", "id": "card_color_scheme", "label": "Form card color scheme", "default": "scheme-2" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer care" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the page title." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>Questions about the serum, an order, or the formula? Send us a message and the AEONAE team will read it and reply by email.</p>"
    },
    { "type": "checkbox", "id": "show_page_content", "label": "Show the page's own content", "info": "Displays the text written in Online Store > Pages > Contact under the introduction.", "default": true },
    { "type": "text", "id": "topics_heading", "label": "Topics heading", "default": "We can help with" },
    { "type": "text", "id": "email_label", "label": "Email link label", "default": "Prefer email?" },
    {
      "type": "text",
      "id": "response_note",
      "label": "Response time note",
      "info": "Optional. Only state a timeframe your team can reliably meet."
    },
    { "type": "header", "content": "Form" },
    { "type": "checkbox", "id": "show_phone", "label": "Show phone field", "default": true },
    { "type": "checkbox", "id": "show_topic_select", "label": "Let customers choose a topic", "info": "Uses the topic blocks as options. The chosen topic is included in the message you receive.", "default": true },
    { "type": "text", "id": "topic_label", "label": "Topic field label", "default": "Topic" },
    { "type": "text", "id": "required_note", "label": "Required fields note", "default": "Required" },
    { "type": "text", "id": "optional_label", "label": "Optional field label", "default": "optional" },
    { "type": "text", "id": "message_label", "label": "Message field label", "default": "Message" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "sending_label", "label": "Sending label", "default": "Sending…" },
    { "type": "text", "id": "email_error", "label": "Email error message", "default": "Enter an email address like name@example.com." },
    { "type": "text", "id": "message_error", "label": "Message error message", "default": "Write a short message so we know how to help." },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "Thank you. Your message has been sent." },
    { "type": "text", "id": "success_text", "label": "Success text", "default": "We'll reply to the email address you provided." },
    { "type": "text", "id": "privacy_text", "label": "Privacy note", "default": "We use your details only to answer your message. See our" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 84 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 108 }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "limit": 8,
      "settings": [{ "type": "text", "id": "topic", "label": "Topic", "default": "Something else" }]
    }
  ],
  "presets": [
    {
      "name": "Contact page",
      "blocks": [
        { "type": "topic", "settings": { "topic": "Orders and delivery" } },
        { "type": "topic", "settings": { "topic": "Returns" } },
        { "type": "topic", "settings": { "topic": "The serum and its ingredients" } },
        { "type": "topic", "settings": { "topic": "Something else" } }
      ]
    }
  ]
}
{% endschema %}
