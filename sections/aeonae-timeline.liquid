{%- comment -%}
  AEONAE timeline (artifact #results intro + .timeline / .tl).
  Centered intro and up to six milestones under a copper rule, three
  columns from 760px. On the results page it opens the mist "Results"
  block; the before and after and customer photo sections follow with
  the same color scheme and reduced padding so the three read as one.
{%- endcomment -%}

{{ 'aeonae-pages.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign motion = settings.animations_reveal_on_scroll
  assign anchor = section.settings.anchor_id | strip | handleize
  assign anim_order = 0

  assign on_dark = false
  assign scheme_brightness = section.settings.color_scheme.settings.background | color_brightness
  if scheme_brightness < 128
    assign on_dark = true
  endif

  assign item_count = 0
  for block in section.blocks
    if block.type == 'milestone'
      assign item_count = item_count | plus: 1
    endif
  endfor
  assign columns = item_count | at_most: 3
-%}

<div
  class="aeo-pg aeo-tl aeo-section color-{{ section.settings.color_scheme }} gradient{% if on_dark %} aeo-on-dark{% endif %}"
  {% if anchor != blank %}
    id="{{ anchor }}"
  {% endif %}
  style="--aeo-pt: {{ section.settings.padding_top }}; --aeo-pb: {{ section.settings.padding_bottom }};"
>
  <div class="aeo-wrap">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="aeo-intro aeo-pg__intro aeo-tl__intro">
        {%- if section.settings.eyebrow != blank -%}
          {%- assign anim_order = anim_order | plus: 1 -%}
          <p
            class="aeo-eyebrow aeo-pg__eyebrow{% if motion %} aeo-reveal scroll-trigger animate--slide-in{% endif %}"
            {% if motion %}
              data-cascade
              style="--animation-order: {{ anim_order }};"
            {% endif %}
          >
            {{- section.settings.eyebrow | escape -}}
          </p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          {%- assign anim_order = anim_order | plus: 1 -%}
          <h2
            class="aeo-h2 aeo-pg__heading aeo-tl__heading{% if motion %} aeo-reveal scroll-trigger animate--slide-in{% endif %}"
            {% if motion %}
              data-cascade
              style="--animation-order: {{ anim_order }};"
            {% endif %}
          >
            {{- section.settings.heading -}}
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          {%- assign anim_order = anim_order | plus: 1 -%}
          <div
            class="aeo-soft aeo-rte rte aeo-pg__text aeo-tl__text{% if motion %} aeo-reveal scroll-trigger animate--slide-in{% endif %}"
            {% if motion %}
              data-cascade
              style="--animation-order: {{ anim_order }};"
            {% endif %}
          >
            {{- section.settings.text -}}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if item_count > 0 -%}
      <ol class="aeo-tl__list" role="list" style="--aeo-cols: {{ columns }};">
        {%- for block in section.blocks -%}
          {%- if block.type == 'milestone' -%}
            {%- assign anim_order = anim_order | plus: 1 -%}
            <li
              class="aeo-tl__item{% if motion %} aeo-reveal scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if motion %}
                data-cascade
                style="--animation-order: {{ anim_order }};"
              {% endif %}
            >
              {%- if block.settings.label != blank -%}
                <h3 class="aeo-tl__label">{{ block.settings.label | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="aeo-tl__desc">{{ block.settings.text }}</p>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    {%- elsif request.design_mode -%}
      <p class="aeo-pg__empty">Add milestone blocks to this section.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Timeline",
  "tag": "section",
  "class": "section aeo-pg-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets links jump here, for example /pages/results#results. Letters, numbers and dashes only."
    },
    {
      "type": "header",
      "content": "Introduction"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Results"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Real skin, shown honestly."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>These frames are reserved for real customers. As our First Edition ships, we will show verified, unretouched photos here so you can see how the serum looks over time.</p>"
    },
    {
      "type": "paragraph",
      "content": "Describe how skin looks or feels over time, not medical outcomes. Individual experiences vary."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 124
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 124
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "First two weeks"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Skin feels comfortable, calm, and hydrated."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Timeline",
      "blocks": [
        {
          "type": "milestone",
          "settings": {
            "label": "First two weeks",
            "text": "Skin feels comfortable, calm, and hydrated."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "label": "Weeks four to eight",
            "text": "The look of a smoother, more even surface."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "label": "Weeks eight to twelve",
            "text": "Firmer, more radiant looking skin for many people."
          }
        }
      ]
    }
  ]
}
{% endschema %}
